def run_image(image_path: str) -> dict:
    try:
        from PIL import Image
        from PIL.ExifTags import TAGS, GPSTAGS
    except ImportError:
        return {"error": "Pillow not installed"}

    result = {"exif": {}, "gps": None, "error": None}
    try:
        img = Image.open(image_path)
        exif = img._getexif() or {}
        gps = {}
        for tag, val in exif.items():
            name = TAGS.get(tag, tag)
            if name == "GPSInfo":
                for k, v in val.items():
                    gps[GPSTAGS.get(k, k)] = v
                continue
            if isinstance(val, (int, float, str)):
                result["exif"][str(name)] = str(val)
        if gps.get("GPSLatitude") and gps.get("GPSLongitude"):
            def to_deg(v):
                d, m, s = v
                return float(d) + float(m) / 60 + float(s) / 3600
            lat = to_deg(gps["GPSLatitude"]) * (-1 if gps.get("GPSLatitudeRef") == "S" else 1)
            lon = to_deg(gps["GPSLongitude"]) * (-1 if gps.get("GPSLongitudeRef") == "W" else 1)
            result["gps"] = {"lat": lat, "lon": lon}
    except Exception as e:
        result["error"] = str(e)
    return result


