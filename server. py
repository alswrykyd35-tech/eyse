def _ensure(pkg, name=None):
    name = name or pkg
    try:
        __import__(name)
    except ImportError:
        print(f"📦 installing {pkg}...")
        subprocess.run([sys.executable, "-m", "pip", "install", "--quiet", pkg], check=False)

for _p, _n in [("requests", "requests"), ("flask", "flask"),
               ("pillow", "PIL"), ("gunicorn", "gunicorn")]:
    try:
        _ensure(_p, _n)
    except Exception:
        pass

