HOME = os.path.expanduser("~")

def run_eyes(email: str) -> str:
    path = os.path.join(HOME, "Eyes", "eyes.py")
    if not os.path.exists(path):
        return ("⚠️ أداة Eyes غير مثبتة.\n\n"
                "للتثبيت على جهازك:\n"
                "git clone https://github.com/N0rz3/Eyes.git ~/Eyes\n"
                "cd ~/Eyes && pip install -r requirements.txt")
